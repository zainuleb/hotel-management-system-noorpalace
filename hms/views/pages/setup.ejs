<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Set up your hotel</title>
<link rel="stylesheet" href="/assets/css/app.css">
</head>
<body>
<div class="auth">
  <form class="auth__card auth__card--wide" method="post" action="/setup" data-allow-resubmit>
    <h1>Welcome</h1>
    <p class="sub">Two minutes of setup and the system is ready to use.</p>

    <% if (error) { %><div class="flash flash--error"><%= error %></div><% } %>

    <h3>Your hotel</h3>
    <div class="form-grid form-grid--2">
      <div class="field span-2">
        <label for="hotel_name">Hotel name</label>
        <input id="hotel_name" name="hotel_name" value="<%= form.hotel_name || '' %>" required autofocus>
      </div>
      <div class="field span-2">
        <label for="hotel_address">Address</label>
        <input id="hotel_address" name="hotel_address" value="<%= form.hotel_address || '' %>">
      </div>
      <div class="field">
        <label for="hotel_phone">Phone</label>
        <input id="hotel_phone" name="hotel_phone" value="<%= form.hotel_phone || '' %>">
      </div>
      <div class="field">
        <label for="currency_symbol">Currency symbol</label>
        <input id="currency_symbol" name="currency_symbol" value="<%= form.currency_symbol || 'Rs.' %>">
      </div>
      <div class="field">
        <label for="tax_percent">Tax on bills (%)</label>
        <input id="tax_percent" name="tax_percent" type="number" step="0.01" min="0" max="100" value="<%= form.tax_percent || '0' %>">
        <small>Leave at 0 if you do not charge tax. You can change it later.</small>
      </div>
    </div>

    <h3 class="mt-1">Your administrator login</h3>
    <div class="form-grid form-grid--2">
      <div class="field">
        <label for="full_name">Your name</label>
        <input id="full_name" name="full_name" value="<%= form.full_name || '' %>" required>
      </div>
      <div class="field">
        <label for="username">Username</label>
        <input id="username" name="username" value="<%= form.username || '' %>" autocomplete="username" required>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required>
        <small>At least 8 characters.</small>
      </div>
      <div class="field">
        <label for="confirm_password">Repeat password</label>
        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required>
      </div>
    </div>

    <label class="check">
      <input type="checkbox" name="seed" value="1" <%= form.seed ? 'checked' : '' %>>
      <span>
        <strong>Add the rooms and a starter menu</strong>
        <small class="muted">18 rooms — 101 to 108 on the ground floor and 201 to 210 on the first — plus a
          sample restaurant menu. The nightly rates are placeholders: set your real tariff under
          Rooms &amp; Room Types afterwards.</small>
      </span>
    </label>

    <button class="btn btn--primary btn--block btn--lg" type="submit">Create my system</button>
  </form>
</div>
</body>
</html>
