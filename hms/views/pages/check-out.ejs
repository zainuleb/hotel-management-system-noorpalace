<%- include('../partials/head', { heading: 'Check out ' + booking.code }) %>

<% if (openOrders.length) { %>
  <div class="notice notice--warn" style="margin-bottom:1rem">
    <strong><%= openOrders.length %> food order(s) are still open</strong> for this guest. They are included in the bill below,
    but check with the kitchen that nothing else is coming.
  </div>
<% } %>

<div class="grid grid--2 grid--wide">
  <div class="card">
    <div class="card__head"><h2>Final bill</h2><div class="spacer"></div><span class="muted"><%= guest.full_name %></span></div>
    <div class="card__body">
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Description</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">Amount</th></tr></thead>
          <tbody>
            <tr><td colspan="4" class="bill-section__title">Room Charges</td></tr>
            <% draft.room_lines.forEach(function (l) { %>
              <tr>
                <td>Room <%= l.room_number %> · <%= fmtDate(l.from_date) %> → <%= fmtDate(l.to_date) %></td>
                <td class="num"><%= l.nights %></td>
                <td class="num"><%= fmt(l.rate_minor) %></td>
                <td class="num"><%= fmt(l.amount_minor) %></td>
              </tr>
            <% }) %>
            <% ['breakfast','lunch','dinner','other'].forEach(function (section) { %>
              <% var group = draft.food_lines.filter(function (l) { return l.section === section; }); %>
              <% if (group.length) { %>
                <tr><td colspan="4" class="bill-section__title"><%= domain.MEAL_LABELS[section] || 'Other' %></td></tr>
                <% group.forEach(function (l) { %>
                  <tr>
                    <td><%= l.description %></td>
                    <td class="num"><%= l.qty %></td>
                    <td class="num"><%= fmt(l.unit_minor) %></td>
                    <td class="num"><%= fmt(l.amount_minor) %></td>
                  </tr>
                <% }) %>
              <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="totals mt-1">
        <div><span>Room charges</span><span><%= fmt(draft.room_charges_minor) %></span></div>
        <div><span>Food charges</span><span><%= fmt(draft.food_charges_minor) %></span></div>
        <% if (draft.discount_minor) { %><div><span>Discount</span><span>− <%= fmt(draft.discount_minor) %></span></div><% } %>
        <% if (draft.tax_minor) { %><div><span><%= hotel.tax_label %> (<%= draft.tax_percent %>%)</span><span><%= fmt(draft.tax_minor) %></span></div><% } %>
        <div class="grand"><span>Total</span><span><%= hotel.currency_symbol %> <%= fmt(draft.total_minor) %></span></div>
        <% if (draft.complimentary_minor) { %>
          <div class="muted"><span>Complimentary (not charged)</span><span><%= fmt(draft.complimentary_minor) %></span></div>
        <% } %>
      </div>
    </div>
  </div>

  <div>
    <div class="card">
      <div class="card__head"><h2>Adjust before billing</h2></div>
      <div class="card__body">
        <form class="filters" method="get" action="/bookings/<%= booking.id %>/check-out">
          <div class="field">
            <label for="departure_date">Check-out date</label>
            <input id="departure_date" name="departure_date" type="date" value="<%= departure %>"
                   min="<%= booking.arrival_date %>">
          </div>
          <div class="field">
            <label for="discount_minor">Discount</label>
            <input id="discount_minor" name="discount_minor" type="number" step="0.01" min="0"
                   value="<%= (discountMinor / 100).toFixed(2) %>">
          </div>
          <button class="btn" type="submit">Recalculate</button>
        </form>
        <small class="muted">
          Changing the check-out date recalculates the nights charged — use it for an early departure.
        </small>
      </div>
    </div>

    <div class="card">
      <div class="card__head"><h2>Settle &amp; check out</h2></div>
      <form method="post" action="/bookings/<%= booking.id %>/check-out">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="departure_date" value="<%= departure %>">
        <input type="hidden" name="discount_minor" value="<%= (discountMinor / 100).toFixed(2) %>">
        <div class="card__body">
          <div class="field">
            <label for="payment_amount">Amount paid now</label>
            <input id="payment_amount" name="payment_amount" type="number" step="0.01" min="0"
                   value="<%= (draft.total_minor / 100).toFixed(2) %>">
            <small>Leave as the full amount for payment in full, reduce it for a part payment, or set 0 to bill later.</small>
          </div>
          <div class="field">
            <label for="payment_mode">Paid by</label>
            <select id="payment_mode" name="payment_mode">
              <% Object.keys(domain.PAYMENT_MODE_LABELS).forEach(function (m) { %>
                <option value="<%= m %>"><%= domain.PAYMENT_MODE_LABELS[m] %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label for="payment_reference">Reference (card slip / transfer id)</label>
            <input id="payment_reference" name="payment_reference">
          </div>
          <div class="field">
            <label for="notes">Note on the invoice</label>
            <input id="notes" name="notes">
          </div>
        </div>
        <div class="card__foot btn-row">
          <button class="btn btn--primary btn--lg" type="submit">Check out &amp; create invoice</button>
          <a class="btn" href="/bookings/<%= booking.id %>">Back</a>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
