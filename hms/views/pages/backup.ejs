<%- include('../partials/head', { heading: 'Backup & Restore' }) %>

<div class="notice" style="margin-bottom:1.1rem">
  A backup is taken automatically when the system starts and once every 24 hours after that.
  The newest <%= backups.length %> are kept here. <strong>Copy them off this PC regularly</strong>, a backup that
  only exists on the machine that failed is not a backup.
</div>

<div class="card">
  <div class="card__head">
    <h2>Backups</h2>
    <div class="spacer"></div>
    <form method="post" action="/admin/backup">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn--primary" type="submit">Back up now</button>
    </form>
  </div>
  <div class="card__body card__body--flush table-wrap">
    <% if (!backups.length) { %>
      <div class="table-empty">No backups yet. Take one now.</div>
    <% } else { %>
      <table class="data">
        <thead><tr><th>File</th><th>Taken</th><th class="num">Size</th><th></th></tr></thead>
        <tbody>
          <% backups.forEach(function (b) { %>
            <tr>
              <td class="mono"><%= b.name %></td>
              <td><%= fmtDateTime(b.created_at) %></td>
              <td class="num"><%= formatBytes(b.size_bytes) %></td>
              <td class="right nowrap">
                <a class="btn btn--sm" href="/admin/backup/download?name=<%= encodeURIComponent(b.name) %>">Download</a>
                <button class="btn btn--sm" type="button" onclick="pickRestore('<%= b.name %>')">Restore</button>
                <form method="post" action="/admin/backup/delete" style="display:inline"
                      data-confirm="Delete this backup file?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="name" value="<%= b.name %>">
                  <button class="btn btn--sm btn--danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<div class="card" id="restore-card" style="display:none">
  <div class="card__head"><h2>Restore a backup</h2></div>
  <form method="post" action="/admin/backup/restore">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="name" id="restore-name">
    <div class="card__body">
      <div class="notice notice--warn">
        <strong>This replaces everything in the live system</strong> with the contents of
        <span class="mono" id="restore-label"></span>. Any bookings, orders or payments entered since that
        backup was taken will be gone. A copy of the current database is saved first, so this can be undone.
      </div>
      <div class="field mt-1">
        <label for="confirm">Type RESTORE to confirm</label>
        <input id="confirm" name="confirm" placeholder="RESTORE" required>
      </div>
    </div>
    <div class="card__foot btn-row">
      <button class="btn btn--danger" type="submit">Restore this backup</button>
      <button class="btn" type="button" onclick="document.getElementById('restore-card').style.display='none'">Cancel</button>
    </div>
  </form>
</div>

<div class="card">
  <div class="card__head"><h2>Off-site copies</h2></div>
  <div class="card__body">
    <p>The whole system lives in one folder. To keep a copy somewhere safe:</p>
    <ol>
      <li>Click <strong>Download</strong> on the newest backup and save it to a USB stick or cloud drive.</li>
      <li>Or copy the <span class="mono">data\backups</span> folder from this PC on a schedule using Windows File History,
        OneDrive, or a simple scheduled copy job.</li>
    </ol>
    <p class="mb-0 muted"><small>Each backup is a single SQLite file containing every booking, order, invoice and payment.
      Restoring it on a fresh install brings the whole hotel back exactly as it was.</small></p>
  </div>
</div>

<script>
  function pickRestore(name) {
    document.getElementById('restore-name').value = name;
    document.getElementById('restore-label').textContent = name;
    var card = document.getElementById('restore-card');
    card.style.display = '';
    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
</script>

<%- include('../partials/foot') %>
