<div class="card no-print">
  <div class="card__body">
    <form class="filters" method="get" action="<%= action %>">
      <div class="btn-row">
        <% [['today','Today'],['yesterday','Yesterday'],['week','Last 7 days'],['month','This month'],['last30','Last 30 days']].forEach(function (p) { %>
          <a class="btn btn--sm <%= preset === p[0] ? 'btn--primary' : '' %>" href="<%= action %>?preset=<%= p[0] %>"><%= p[1] %></a>
        <% }) %>
      </div>
      <div class="field"><label for="from">From</label><input id="from" name="from" type="date" value="<%= from %>"></div>
      <div class="field"><label for="to">To</label><input id="to" name="to" type="date" value="<%= to %>"></div>
      <input type="hidden" name="preset" value="custom">
      <% if (typeof extraFields !== 'undefined' && extraFields) { %><%- extraFields %><% } %>
      <button class="btn btn--primary" type="submit">Apply</button>
      <div style="flex:1"></div>
      <button class="btn" type="button" onclick="window.print()">Print</button>
      <% if (typeof csv !== 'undefined' && csv) { %>
        <a class="btn" href="/reports/export.csv?report=<%= csv %>&preset=custom&from=<%= from %>&to=<%= to %>">Export CSV</a>
      <% } %>
    </form>
  </div>
</div>
