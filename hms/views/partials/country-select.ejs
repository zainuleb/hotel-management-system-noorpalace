<%
  /*
   * Nationality picker. A guest whose country was typed in before this list
   * existed, or spelled some other way, keeps their value: it is added as an
   * extra option rather than being silently reset to blank.
   */
  var current = typeof value === 'string' ? value.trim() : '';
  var known = countries.indexOf(current) !== -1;
%>
<select id="<%= name %>" name="<%= name %>">
  <option value="">Not stated</option>
  <% if (current && !known) { %>
    <option value="<%= current %>" selected><%= current %></option>
  <% } %>
  <optgroup label="Common">
    <% commonCountries.forEach(function (c) { %>
      <option value="<%= c %>" <%= current === c ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </optgroup>
  <optgroup label="All countries">
    <% countries.forEach(function (c) { %>
      <option value="<%= c %>" <%= current === c ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </optgroup>
</select>
